<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- v2.7.9: alinhado com SteelBIM.csproj (annotations). Permite que arquivos
         incluidos via &lt;Compile Include&gt; usem sintaxe nullable sem warning CS8632. -->
    <Nullable>annotations</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <PlatformTarget>x64</PlatformTarget>
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <!-- v2.7.10: build reproducivel via lock file. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <!-- v1.7.0 PR-3: precisamos do tipo SentryEvent + interface IHub para
         testar SentryOptionsBuilder, BeforeSend hook e o ISentryHubFacade
         mockavel. Mesmo pin que o csproj principal (ADR-007 §6). -->
    <PackageReference Include="Sentry" Version="5.6.0" />
    <!-- PR-4 nao usa NuGet PostHog — implementacao HTTP-direct via
         HttpClient + System.Text.Json (BCL). Ver ADR-008. -->
  </ItemGroup>

