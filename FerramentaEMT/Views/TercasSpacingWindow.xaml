<Window x:Class="FerramentaEMT.Views.TercasSpacingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Espaçamentos das Terças"
        Width="420"
        MinWidth="380"
        MinHeight="420"
        MaxHeight="720"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FerramentaEMT;component/Views/Themes/AppTheme.Base.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0 0 0 12">
            <TextBlock Text="Espaçamentos das Terças" Style="{StaticResource DialogTitleText}"/>
            <TextBlock Text="Ative o modo manual e edite as distâncias entre as linhas e as terças."
                       Style="{StaticResource DialogSubtitleText}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <CheckBox x:Name="chkEspacamentoManual"
                  Grid.Row="1"
                  Content="Ajustar distâncias manualmente entre linhas"
                  Margin="0 0 0 12"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="panelEspacamentosEditor"/>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 12 0 0">
            <Button x:Name="btnCancel" Content="Cancelar" Width="90" Style="{StaticResource SecondaryActionButton}" Margin="0 0 8 0" Click="BtnCancel_Click"/>
            <Button x:Name="btnOk" Content="Aplicar" Width="90" Style="{StaticResource PrimaryActionButton}" Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>
