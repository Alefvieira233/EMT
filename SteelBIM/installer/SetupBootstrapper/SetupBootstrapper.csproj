<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SteelBIM.SetupBootstrapper</AssemblyName>
    <RootNamespace>SteelBIM.SetupBootstrapper</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="EmbeddedPackage\SteelBIM-Package.zip" LogicalName="SteelBIM.SetupBootstrapper.Package.zip" />
    <EmbeddedResource Include="..\..\..\docs\legal\EULA.md" LogicalName="SteelBIM.SetupBootstrapper.EULA.md" />
  </ItemGroup>

</Project>
