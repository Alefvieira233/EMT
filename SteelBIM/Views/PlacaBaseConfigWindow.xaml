<Window x:Class="SteelBIM.Views.PlacaBaseConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lançar Placas de Base"
        Width="560"
        MinWidth="520" MinHeight="520" MaxHeight="800"
        SizeToContent="Height"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <!--
        v2.6.4 (hotfix UX): root trocado de Grid (3 rows, Row 1 = "*") para
        DockPanel com footer Dock=Bottom + ScrollViewer fill. Height=720 fixo
        cortava conteudo em laptop 768px + DPI alto. Agora SizeToContent=Height
        com MaxHeight=800 + scroll automatico.

        Botoes ganharam x:Name (btnLancar + btnCancelar) mas mantem handlers
        originais (BtnOk_Click + BtnCancel_Click no code-behind) — zero risco
        em runtime, so consistencia com as outras 4 janelas refatoradas em
        v2.6.4.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SteelBIM;component/Views/Themes/AppTheme.Base.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- Footer FIXO no rodape -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource ActionBarBorder}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnCancelar"
                        Content="Cancelar"
                        Width="90" Height="32"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        TabIndex="98"
                        Click="BtnCancel_Click"/>
                <Button x:Name="btnLancar"
                        Content="Lançar"
                        Width="90" Height="32"
                        IsDefault="True"
                        TabIndex="99"
                        Click="BtnOk_Click"/>
            </StackPanel>
        </Border>

        <!-- Conteudo principal com scroll automatico -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16">
            <StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Placas de Base" Style="{StaticResource DialogTitleText}"/>
                    <TextBlock Text="Seleciona um tipo face-based carregado no modelo e lança automaticamente a placa no topo do concreto abaixo de cada pilar metálico."
                               Style="{StaticResource DialogSubtitleText}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <GroupBox Header="Família de placa" Margin="0,0,0,12">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Família" Style="{StaticResource LabelText}"/>
                        <ComboBox x:Name="cmbFamilia"
                                  Grid.Row="1"
                                  Height="32"
                                  Padding="8"
                                  Margin="0,0,0,8"
                                  DisplayMemberPath="FamilyName"
                                  SelectionChanged="CmbFamilia_SelectionChanged"
                                  TabIndex="1"/>

                        <TextBlock Grid.Row="2" Text="Tipo" Style="{StaticResource LabelText}"/>
                        <ComboBox x:Name="cmbTipo"
                                  Grid.Row="3"
                                  Height="32"
                                  Padding="8"
                                  DisplayMemberPath="TypeName"
                                  TabIndex="2"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Parâmetros" Margin="0,0,0,12">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Comprimento (mm)" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="txtComprimento" Grid.Row="1" Grid.Column="0" Height="28" Padding="6" Text="300" Margin="0,0,0,8" TabIndex="10"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Largura (mm)" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="txtLargura" Grid.Row="1" Grid.Column="2" Height="28" Padding="6" Text="300" Margin="0,0,0,8" TabIndex="11"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Espessura (mm)" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="txtEspessura" Grid.Row="3" Grid.Column="0" Height="28" Padding="6" Text="20" Margin="0,0,0,8" TabIndex="12"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Furo Diâmetro (mm)" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="txtFuroDiametro" Grid.Row="3" Grid.Column="2" Height="28" Padding="6" Text="22" Margin="0,0,0,8" TabIndex="13"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Furo Offset X (mm)" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="txtFuroOffsetX" Grid.Row="5" Grid.Column="0" Height="28" Padding="6" Text="80" Margin="0,0,0,8" TabIndex="14"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Furo Offset Y (mm)" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="txtFuroOffsetY" Grid.Row="5" Grid.Column="2" Height="28" Padding="6" Text="80" Margin="0,0,0,8" TabIndex="15"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Chumbador Diâmetro (mm)" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="txtChumbadorDiametro" Grid.Row="7" Grid.Column="0" Height="28" Padding="6" Text="19" Margin="0,0,0,8" TabIndex="16"/>
                        <TextBlock Grid.Row="6" Grid.Column="2" Text="Graute Espessura (mm)" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="txtGrauteEspessura" Grid.Row="7" Grid.Column="2" Height="28" Padding="6" Text="30" Margin="0,0,0,8" TabIndex="17"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Solda" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="txtSolda" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3" Height="28" Padding="6" Text="6 mm" TabIndex="18"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Opções">
                    <Grid Margin="8">
                        <CheckBox x:Name="chkSobrescreverParametros"
                                  Content="Aplicar os valores acima nos parâmetros da família após inserir"
                                  IsChecked="True"
                                  TabIndex="19"/>
                    </Grid>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
