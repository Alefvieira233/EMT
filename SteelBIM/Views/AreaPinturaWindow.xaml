<Window x:Class="SteelBIM.Views.AreaPinturaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Área de Pintura — Quantitativo"
        Width="440"
        Height="420"
        MinWidth="400" MinHeight="380"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">
    <DockPanel LastChildFill="True">

        <Border DockPanel.Dock="Bottom" BorderBrush="LightGray" BorderThickness="0,1,0,0" Padding="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnCancel" Content="Cancelar" Width="90" Height="28" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="btnOk" Content="Calcular" Width="110" Height="28" IsDefault="True"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="LightGray" Padding="10,6">
            <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                       Text="Calcula a área de pintura (perímetro × comprimento) pela geometria do perfil, grava no parâmetro EMT_Area_Pintura e gera a tabela. Funciona mesmo sem material aplicado."/>
        </Border>

        <StackPanel Margin="12">

            <GroupBox Header="Escopo" Margin="0,0,0,8">
                <StackPanel Margin="6">
                    <RadioButton x:Name="rbModelo" Content="Todo o modelo" IsChecked="True" Margin="0,2,0,2"/>
                    <RadioButton x:Name="rbSelecao" Content="Apenas a seleção atual" Margin="0,2,0,2"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Categorias" Margin="0,0,0,8">
                <StackPanel Margin="6" Orientation="Horizontal">
                    <CheckBox x:Name="chkVigas" Content="Vigas (Structural Framing)" IsChecked="True" Margin="0,0,16,0"/>
                    <CheckBox x:Name="chkPilares" Content="Pilares" IsChecked="True"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Desconto" Margin="0,0,0,8">
                <StackPanel Margin="6">
                    <CheckBox x:Name="chkDescontarTopos" Content="Descontar os topos das barras (faces de corte)" IsChecked="True" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Desconto adicional (%):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="txtDesconto" Width="60" Text="5"/>
                        <TextBlock Text="  (parafusos/folgas)" Foreground="Gray" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <CheckBox x:Name="chkCriarTabela" Content="Criar/atualizar a tabela de quantitativo" IsChecked="True" Margin="2,2,0,0"/>

        </StackPanel>
    </DockPanel>
</Window>
