<Window x:Class="SteelBIM.Views.ConexaoTercasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conexão de Terça"
        Width="440"
        Height="780"
        MinWidth="380"
        MinHeight="400"
        MaxHeight="920"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <!--
        v2.8.5 (hotfix UI): DockPanel com botões fixos no rodapé + ScrollViewer
        pro conteúdo. Antes a janela tinha Height=Auto + MaxHeight=700, e em DPI
        alto / parametros da familia populados, o conteúdo passava de 700 e os
        botões "Inserir/Cancelar" saiam da viewport — usuário não conseguia
        avançar. Mesmo padrao do TercasWindow.xaml (v2.6.4) que ja resolveu o
        mesmo bug.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SteelBIM;component/Views/Themes/AppTheme.Base.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- Footer FIXO no rodapé: btnCancel/btnOk sempre visiveis -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource ActionBarBorder}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnCancel" Content="Cancelar" Width="90"
                        Style="{StaticResource SecondaryActionButton}"
                        Margin="0 0 8 0" Click="BtnCancel_Click" IsCancel="True"/>
                <Button x:Name="btnOk" Content="Inserir" Width="90"
                        Style="{StaticResource PrimaryActionButton}"
                        Click="BtnOk_Click" IsDefault="True"/>
            </StackPanel>
        </Border>

        <!-- Conteúdo principal: scrolla se janela for menor que o conteúdo -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16">
            <StackPanel>

                <!-- Título -->
                <StackPanel Margin="0 0 0 12">
                    <TextBlock Text="Conexão de Terça" Style="{StaticResource DialogTitleText}"/>
                    <TextBlock x:Name="txtSubtitulo"
                               Style="{StaticResource DialogSubtitleText}" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Família -->
                <Grid Margin="0 0 0 10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Família:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cmbFamilia" Grid.Column="1" SelectionChanged="CmbFamilia_SelectionChanged"/>
                </Grid>

                <Grid Margin="0 0 0 14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Tipo:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cmbTipo" Grid.Column="1" SelectionChanged="CmbTipo_SelectionChanged"/>
                </Grid>

                <!-- Posições -->
                <GroupBox Header="Posições de inserção" Margin="0 0 0 10">
                    <StackPanel Margin="8 6 8 6">
                        <CheckBox x:Name="chkExtremidades" Content="Extremidades da terça" IsChecked="True" Margin="0 0 0 6"/>
                        <CheckBox x:Name="chkMeio" Content="Meio da terça (emenda / suporte intermediário)"/>
                    </StackPanel>
                </GroupBox>

                <!-- Parâmetros da família (populados dinamicamente quando tipo é selecionado) -->
                <GroupBox x:Name="grpParametros"
                          Header="Parâmetros da família"
                          Margin="0 0 0 10"
                          Visibility="Collapsed">
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="stkParametros" Margin="8 6 8 6"/>
                    </ScrollViewer>
                </GroupBox>

                <!-- Ajuste fino (expansível) -->
                <Expander Header="Ajuste fino" Margin="0 0 0 14" IsExpanded="False">
                    <StackPanel Margin="8 8 8 4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Offset de rotação:"
                                       VerticalAlignment="Center" Margin="0 0 0 8"/>
                            <TextBox x:Name="numRotacaoOffset"
                                     Grid.Row="0" Grid.Column="1"
                                     Text="0" TextAlignment="Right"
                                     Margin="0 0 0 8"/>
                            <TextBlock Grid.Row="0" Grid.Column="2"
                                       Text="°" Margin="6 0 0 8" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Offset vertical adicional:"
                                       VerticalAlignment="Center" Margin="0 0 0 8"/>
                            <TextBox x:Name="numOffsetVertical"
                                     Grid.Row="1" Grid.Column="1"
                                     Text="0" TextAlignment="Right" Margin="0 0 0 8"/>
                            <TextBlock Grid.Row="1" Grid.Column="2"
                                       Text="mm" Margin="6 0 0 8" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="Offset lateral (eixo da terça):"
                                       VerticalAlignment="Center" Margin="0 0 0 8"/>
                            <TextBox x:Name="numOffsetLateral"
                                     Grid.Row="2" Grid.Column="1"
                                     Text="0" TextAlignment="Right" Margin="0 0 0 8"/>
                            <TextBlock Grid.Row="2" Grid.Column="2"
                                       Text="mm" Margin="6 0 0 8" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="3" Grid.Column="0"
                                       Text="Referência da chapa:"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmbReferenciaChapa"
                                      Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                      ToolTip="Cruzamento (default): centra no encontro terça x viga. Origem da terça: honra a origem da família (alinha pela referência da terça).">
                                <ComboBoxItem Content="Centralizar no cruzamento" IsSelected="True"/>
                                <ComboBoxItem Content="Origem da terça (não centralizar)"/>
                            </ComboBox>
                        </Grid>

                        <!-- v2.8.2: Modo Completo + Viga tipo I -->
                        <CheckBox x:Name="chkModoCompleto"
                                  Content="Ajustar altura à viga (Modo Completo)"
                                  Margin="0 10 0 0"
                                  ToolTip="Quando ativo, calcula a altura da chapa até o topo da viga de apoio via raycast. Requer que a família tenha o parâmetro Altura_PlacaInf_a_Terca. Sem o parâmetro, a opção é ignorada silenciosamente."/>
                        <CheckBox x:Name="chkVigaTipoI"
                                  Content="Viga de apoio é perfil tipo I (W, H, IPN, IPE)"
                                  Margin="20 6 0 0"
                                  ToolTip="Quando ativo, desconta a espessura da mesa (tf) no cálculo de altura. Use se as vigas de apoio são perfis I/W/H — não use para retangulares, U ou C."/>

                        <!-- v2.8.3+ override manual da heuristica de face hospedeira -->
                        <CheckBox x:Name="chkInverterFace"
                                  Content="Inverter face hospedeira (interna ↔ externa)"
                                  Margin="0 10 0 0"
                                  ToolTip="Use se a chapa estiver saindo no lado errado da alma. A heurística automática escolhe a face da alma cujo centro está mais próximo da viga; marque pra forçar a face oposta."/>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
