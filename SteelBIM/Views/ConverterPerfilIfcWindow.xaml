<Window x:Class="SteelBIM.Views.ConverterPerfilIfcWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Converter Perfis IFC"
        Width="1140" Height="700"
        MinWidth="900" MinHeight="560"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SteelBIM;component/Views/Themes/AppTheme.Base.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titulo -->
        <StackPanel Grid.Row="0" Margin="0 0 0 10">
            <TextBlock Text="Converter Perfis IFC para Perfis Nativos do Revit"
                       Style="{StaticResource DialogTitleText}"/>
            <TextBlock Style="{StaticResource DialogSubtitleText}" Margin="0,4,0,0"
                       Text="Parametros IFC lidos de cada elemento: IfcMaterial (secao e norma), IfcName (nome do membro), IfcGUID."/>
        </StackPanel>

        <!-- Opcoes -->
        <GroupBox Grid.Row="1" Header="Opcoes de conversao" Margin="0 0 0 8" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- v2.7.0 BUG 5: label visivel + tooltip detalhado garantem que
                     o usuario perceba e entenda a opcao. -->
                <Label Grid.Column="0" Content="Ler perfil do parametro IFC:" VerticalAlignment="Center"
                       ToolTip="Escolha de qual parametro IFC sera lido o nome do perfil estrutural."/>
                <ComboBox x:Name="cmbParamIfc" Grid.Column="1" Margin="4,0" Height="26"
                          SelectionChanged="CmbParamIfc_SelectionChanged"
                          ToolTip="Default: IfcMaterial (formato CYPE/AISC). Outras opcoes detectadas automaticamente do modelo: IfcName, IfcObjectType, IfcDescription, etc."/>

                <Label Grid.Column="3" Content="Nivel padrao (fallback):" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbNivelPadrao" Grid.Column="4" Margin="4,0" Height="26"/>

                <CheckBox x:Name="chkDeletarOriginal"
                          Grid.Column="6"
                          Content="Deletar elementos IFC originais apos a conversao"
                          VerticalAlignment="Center"
                          IsChecked="True"/>
            </Grid>
        </GroupBox>

        <!-- Barra de acoes do DataGrid -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
            <Button x:Name="btnSelecionarTodos" Content="Selecionar tudo"
                    Width="130" Height="28" Margin="0,0,6,0"
                    Style="{StaticResource SecondaryActionButton}"/>
            <Button x:Name="btnDeselecionarTodos" Content="Deselecionar tudo"
                    Width="130" Height="28" Margin="0,0,12,0"
                    Style="{StaticResource SecondaryActionButton}"/>
            <TextBlock x:Name="lblContagem" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid x:Name="gridElementos"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  FontSize="12"
                  Margin="0,0,0,10">
            <DataGrid.Columns>

                <DataGridCheckBoxColumn Header="Converter"
                                        Binding="{Binding Selecionado, UpdateSourceTrigger=PropertyChanged}"
                                        Width="72"/>

                <DataGridTextColumn Header="Qtd."
                                    Binding="{Binding Quantidade}"
                                    IsReadOnly="True"
                                    Width="48"/>

                <DataGridTextColumn Header="Secao IFC"
                                    Binding="{Binding SecaoSugerida}"
                                    IsReadOnly="True"
                                    Width="160"/>

                <DataGridTemplateColumn Header="Valor IFC" Width="200" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ValorIfc}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Padding="4,0"
                                       ToolTip="{Binding ValorIfc}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Familia Revit" Width="230">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FamiliaSelecionada}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Padding="4,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding Familias}"
                                      SelectedItem="{Binding FamiliaSelecionada, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Tipo Revit" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding PerfilNome}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Padding="4,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding TiposDisponiveis}"
                                      SelectedItem="{Binding PerfilSelecionado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="Text"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="Text"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- Botoes -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock VerticalAlignment="Center" Margin="0,0,16,0"
                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                       Text="Clique duas vezes na celula para editar. Familia filtra os tipos disponiveis."/>
            <Button x:Name="btnCancelar" Content="Cancelar" Width="100" Height="32" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryActionButton}"/>
            <Button x:Name="btnConverter" Content="Converter" Width="130" Height="32"
                    Style="{StaticResource PrimaryActionButton}"/>
        </StackPanel>
    </Grid>
</Window>
