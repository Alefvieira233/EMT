<Window x:Class="SteelBIM.Views.DiagramaMontagemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagrama de Montagem"
        Width="540" Height="420"
        MinWidth="480" MinHeight="380"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SteelBIM;component/Views/Themes/AppTheme.Base.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0 0 0 12">
            <TextBlock Text="Diagrama de Montagem" Style="{StaticResource DialogTitleText}"/>
            <TextBlock Text="Gera uma vista de elevacao dos elementos selecionados, com eixos do projeto visiveis, cotas entre eixos e tags de marca em cada peca."
                       Style="{StaticResource DialogSubtitleText}" TextWrapping="Wrap"/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="Orientacao da vista" Margin="0 0 0 12">
            <StackPanel Orientation="Horizontal" Margin="8">
                <RadioButton x:Name="rbAuto" Content="Automatica" IsChecked="True" Margin="0 0 16 0"/>
                <RadioButton x:Name="rbX" Content="Paralela ao eixo X" Margin="0 0 16 0"/>
                <RadioButton x:Name="rbY" Content="Paralela ao eixo Y"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Conteudo da vista" Margin="0 0 0 12">
            <StackPanel Margin="8">
                <CheckBox x:Name="chkEixos" Content="Mostrar eixos do projeto" IsChecked="True" Margin="0 4"/>
                <CheckBox x:Name="chkCotas" Content="Adicionar cotas entre eixos consecutivos" IsChecked="True" Margin="0 4"/>
                <CheckBox x:Name="chkTags" Content="Adicionar tags com marca de fabricacao (Mark)" IsChecked="True" Margin="0 4"/>
            </StackPanel>
        </GroupBox>

        <Border Grid.Row="3" Style="{StaticResource SubtleCardBorder}" Margin="0 0 0 12">
            <TextBlock x:Name="txtResumo" TextWrapping="Wrap" Padding="8"/>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnCancel" Content="Cancelar" Width="96" Style="{StaticResource SecondaryActionButton}" Margin="0 0 8 0" Click="BtnCancel_Click"/>
            <Button x:Name="btnGerar" Content="Gerar Diagrama" Width="140" Style="{StaticResource PrimaryActionButton}" Click="BtnGerar_Click"/>
        </StackPanel>
    </Grid>
</Window>
