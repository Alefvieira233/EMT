<Window x:Class="SteelBIM.Views.AlinharVistasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alinhar / Distribuir Vistas"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SteelBIM;component/Views/Themes/AppTheme.Base.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="14" MinWidth="320">
        <TextBlock Text="Selecione 2+ vistas na prancha e escolha a ação:" Margin="0 0 0 10" TextWrapping="Wrap"/>

        <GroupBox Header="Alinhar" Padding="8">
            <UniformGrid Columns="3" Rows="2">
                <Button x:Name="btnEsquerda" Content="◧  Esquerda" Margin="3" Padding="6,4"/>
                <Button x:Name="btnCentroH" Content="▣  Centro H" Margin="3" Padding="6,4"/>
                <Button x:Name="btnDireita" Content="◨  Direita" Margin="3" Padding="6,4"/>
                <Button x:Name="btnTopo" Content="⬒  Topo" Margin="3" Padding="6,4"/>
                <Button x:Name="btnCentroV" Content="▤  Centro V" Margin="3" Padding="6,4"/>
                <Button x:Name="btnBase" Content="⬓  Base" Margin="3" Padding="6,4"/>
            </UniformGrid>
        </GroupBox>

        <GroupBox Header="Distribuir (3+ vistas)" Padding="8" Margin="0 8 0 0">
            <UniformGrid Columns="2" Rows="1">
                <Button x:Name="btnDistribuirH" Content="↔  Horizontal" Margin="3" Padding="6,4"/>
                <Button x:Name="btnDistribuirV" Content="↕  Vertical" Margin="3" Padding="6,4"/>
            </UniformGrid>
        </GroupBox>

        <Button x:Name="btnCancelar" Content="Cancelar" Width="100" HorizontalAlignment="Right"
                Margin="0 12 0 0" Style="{StaticResource SecondaryActionButton}"/>
    </StackPanel>
</Window>
