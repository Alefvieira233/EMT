<Window x:Class="SteelBIM.Views.PlanoMontagemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sequenciamento BIM"
        Width="700"
        Height="600"
        MinWidth="620" MinHeight="520" MaxHeight="800"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <!--
        v2.6.4 (hotfix UX): root trocado de Grid (3 rows com Row 1 = "*" TabControl)
        para DockPanel com footer Dock=Bottom + TabControl LastChildFill. Em DPI
        125%/150%, conteudo Auto + Row=star do TabControl estourava 600px e os
        botoes OK/Cancelar saiam da viewport.

        Mantemos Height=600 fixo (sem SizeToContent) porque o tab "Visualizar
        Plano" tem DataGrid que precisa de altura disponivel pra mostrar etapas
        de montagem. TabControl mede so o tab ativo, entao SizeToContent daria
        flicker ao trocar de tab. MaxHeight=800 (ajustado de 720) acomoda
        DataGrid maior em modelos com muitas etapas.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SteelBIM;component/Views/Themes/AppTheme.Base.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- Footer FIXO no rodape: OK/Cancelar sempre visiveis -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource ActionBarBorder}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnCancel"
                        Content="Cancelar"
                        Width="80" Height="32"
                        Margin="0,0,8,0"
                        Background="{DynamicResource ButtonBackgroundBrush}"
                        Foreground="{DynamicResource ButtonForegroundBrush}"
                        IsCancel="True"
                        TabIndex="98"
                        Click="BtnCancel_Click"/>
                <Button x:Name="btnOk"
                        Content="OK"
                        Width="80" Height="32"
                        Background="{DynamicResource ButtonBackgroundBrush}"
                        Foreground="{DynamicResource ButtonForegroundBrush}"
                        IsDefault="True"
                        TabIndex="99"
                        Click="BtnOk_Click"/>
            </StackPanel>
        </Border>

        <!-- Header fixo no topo -->
        <StackPanel DockPanel.Dock="Top" Margin="16,16,16,12">
            <TextBlock Text="Sequenciamento BIM (4D Phasing)" Style="{StaticResource DialogTitleText}"/>
            <TextBlock Text="Atribua fases de montagem a elementos selecionados, aplique destaque visual com cores customizaveis e exporte relatorio para planejamento 4D."
                       Style="{StaticResource DialogSubtitleText}"/>
        </StackPanel>

        <!-- TabControl preenche o restante (LastChildFill) -->
        <TabControl Margin="16,0,16,12"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    TabIndex="1">

            <!-- Tab 1: Atribuir Etapa -->
            <TabItem Header="Atribuir Etapa">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Número da etapa (inteiro positivo)" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtNumeroEtapa" Grid.Row="1" Height="32" Padding="8"
                             Background="{DynamicResource TextBoxBackgroundBrush}"
                             Foreground="{DynamicResource TextBoxForegroundBrush}"
                             Text="1" Margin="0,0,0,12"
                             TabIndex="10"/>

                    <TextBlock Grid.Row="2" Text="Descrição (opcional)" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtDescricao" Grid.Row="3" Height="32" Padding="8"
                             Background="{DynamicResource TextBoxBackgroundBrush}"
                             Foreground="{DynamicResource TextBoxForegroundBrush}"
                             Margin="0,0,0,12"
                             TabIndex="11"/>

                    <Button x:Name="btnAtribuir" Grid.Row="4" Content="Atribuir aos Selecionados" Height="36"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource ButtonForegroundBrush}"
                            VerticalAlignment="Top"
                            TabIndex="12"
                            Click="BtnAtribuir_Click"/>
                </Grid>
            </TabItem>

            <!-- Tab 2: Visualizar Plano -->
            <TabItem Header="Visualizar Plano">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="btnGerarPlano" Grid.Row="0" Content="Gerar Sequenciamento" Height="36"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource ButtonForegroundBrush}"
                            Margin="0,0,0,12"
                            TabIndex="20"
                            Click="BtnGerarPlano_Click"/>

                    <DataGrid x:Name="dgEtapas" Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="False"
                              Background="{DynamicResource PanelBackgroundBrush}"
                              Foreground="{DynamicResource TextBoxForegroundBrush}"
                              TabIndex="21">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Etapa" Binding="{Binding Etapa}" IsReadOnly="True" Width="60"/>
                            <DataGridTextColumn Header="Descricao" Binding="{Binding Descricao}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Quantidade" Binding="{Binding Quantidade}" IsReadOnly="True" Width="100"/>
                            <DataGridTemplateColumn Header="Cor" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Escolher"
                                                Background="{Binding CorAtualBrush}"
                                                Foreground="White"
                                                FontSize="10"
                                                Margin="2"
                                                Click="BtnEscolherCor_Click"
                                                Tag="{Binding Etapa}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 3: Exportar Relatório -->
            <TabItem Header="Exportar Relatório">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Caminho do arquivo Excel" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="txtCaminhoRelatorio" Grid.Column="0" Height="32" Padding="8"
                                 Background="{DynamicResource TextBoxBackgroundBrush}"
                                 Foreground="{DynamicResource TextBoxForegroundBrush}"
                                 TabIndex="30"/>

                        <Button x:Name="btnBrowse" Grid.Column="1" Content="..." Width="40" Height="32"
                                Background="{DynamicResource ButtonBackgroundBrush}"
                                Foreground="{DynamicResource ButtonForegroundBrush}"
                                Margin="8,0,0,0"
                                TabIndex="31"
                                Click="BtnBrowse_Click"/>
                    </Grid>

                    <Button x:Name="btnExportar" Grid.Row="2" Content="Exportar para Excel" Height="36"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource ButtonForegroundBrush}"
                            TabIndex="32"
                            Click="BtnExportar_Click"/>
                </Grid>
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
