<Window x:Class="SteelBIM.Views.TercasSpacingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Espaçamentos das Terças"
        Width="440"
        MinWidth="400"
        MinHeight="440"
        MaxHeight="760"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SteelBIM;component/Views/Themes/AppTheme.Base.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <StackPanel Grid.Row="0" Margin="0 0 0 10">
            <TextBlock Text="Espaçamentos das Terças" Style="{StaticResource DialogTitleText}"/>
            <TextBlock Text="Edite o vão total e as distâncias. Os campos ajustam automaticamente."
                       Style="{StaticResource DialogSubtitleText}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Perfil + Vão total -->
        <Border Grid.Row="1"
                Background="{DynamicResource InputBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10 8"
                Margin="0 0 0 10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Perfil selecionado:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Margin="0 0 0 6"/>
                <TextBlock x:Name="lblPerfil"
                           Grid.Row="0" Grid.Column="1"
                           VerticalAlignment="Center"
                           Margin="0 0 0 6"
                           TextWrapping="Wrap"
                           Text="—"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Vão total:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="txtVaoTotal"
                             Width="90"
                             TextAlignment="Right"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Text="cm"
                               VerticalAlignment="Center"
                               Margin="6 0 0 0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Modo manual -->
        <CheckBox x:Name="chkEspacamentoManual"
                  Grid.Row="2"
                  Content="Ajustar distâncias manualmente entre linhas"
                  Margin="0 0 0 10"/>

        <!-- Lista de espaçamentos -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="panelEspacamentosEditor"/>
        </ScrollViewer>

        <!-- Botões -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 12 0 0">
            <Button x:Name="btnCancel" Content="Cancelar" Width="90"
                    Style="{StaticResource SecondaryActionButton}"
                    Margin="0 0 8 0" Click="BtnCancel_Click"/>
            <Button x:Name="btnOk" Content="Aplicar" Width="90"
                    Style="{StaticResource PrimaryActionButton}"
                    Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>
