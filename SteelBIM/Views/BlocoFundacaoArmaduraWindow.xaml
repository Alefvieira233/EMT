<Window x:Class="SteelBIM.Views.BlocoFundacaoArmaduraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bloco de Fundação — Armaduras Manuais"
        Width="720" Height="680" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecalho -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" Margin="0,0,0,6">
            <TextBlock x:Name="txtElementInfo" FontSize="11" Foreground="Gray" Padding="2,0,0,4"
                       Text="Selecione um bloco de fundacao para usar a geometria real."/>
        </Border>

        <!-- TabControl principal -->
        <TabControl Grid.Row="1" x:Name="tabMain">

            <!-- ============================================================
                 TAB INFERIOR
                 ============================================================ -->
            <TabItem Header="Inferior">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <CheckBox x:Name="chkLancarInferior" Content="Lançar armadura inferior" IsChecked="True"
                                  FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <!-- Barras X -->
                        <GroupBox Header="Barras em X  (distribuídas ao longo de Y)" Margin="0,0,0,6">
                            <Grid Margin="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <CheckBox x:Name="chkInfXAtivo" Content="Ativo" IsChecked="True" Margin="0,0,0,4"/>
                                    <Label Content="Vergalhão:" Padding="0,2,0,0"/>
                                    <ComboBox x:Name="cmbInfXBarra" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <Label Content="Cobrimento (cm):" Padding="0,2,0,0"/>
                                            <TextBox x:Name="txtInfXCob" Text="5"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <Label Content="Offset Z (cm):" Padding="0,2,0,0"/>
                                            <TextBox x:Name="txtInfXOffZ" Text="0"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <RadioButton x:Name="rbInfXQtd" Content="Por quantidade" IsChecked="True" Margin="0,0,8,0"/>
                                        <RadioButton x:Name="rbInfXEsp" Content="Por espaçamento"/>
                                    </StackPanel>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <Label Content="Quantidade:" Padding="0,2,0,0"/>
                                            <TextBox x:Name="txtInfXQtd" Text="4"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <Label Content="Espaçamento (cm):" Padding="0,2,0,0"/>
                                            <TextBox x:Name="txtInfXEsp" Text="15" IsEnabled="False"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <GroupBox Grid.Column="1" Header="Dobra">
                                    <StackPanel Margin="4">
                                        <CheckBox x:Name="chkInfXDobI" Content="Dobra inicial" Margin="0,0,0,2"/>
                                        <Label Content="Comprimento (cm):" Padding="0,0,0,0"/>
                                        <TextBox x:Name="txtInfXDobIComp" Text="10" Margin="0,0,0,2"/>
                                        <RadioButton x:Name="rbInfXDobICima" Content="Para cima" IsChecked="True" GroupName="InfXDobIDir"/>
                                        <RadioButton x:Name="rbInfXDobIBaixo" Content="Para baixo" GroupName="InfXDobIDir" Margin="0,0,0,6"/>
                                        <Separator/>
                                        <CheckBox x:Name="chkInfXDobF" Content="Dobra final" Margin="0,4,0,2"/>
                                        <Label Content="Comprimento (cm):" Padding="0,0,0,0"/>
                                        <TextBox x:Name="txtInfXDobFComp" Text="10" Margin="0,0,0,2"/>
                                        <RadioButton x:Name="rbInfXDobFCima" Content="Para cima" IsChecked="True" GroupName="InfXDobFDir"/>
                                        <RadioButton x:Name="rbInfXDobFBaixo" Content="Para baixo" GroupName="InfXDobFDir"/>
                                    </StackPanel>
                                </GroupBox>
                            </Grid>
                        </GroupBox>

                        <!-- Barras Y -->
                        <GroupBox Header="Barras em Y  (distribuídas ao longo de X)">
                            <Grid Margin="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <CheckBox x:Name="chkInfYAtivo" Content="Ativo" IsChecked="True" Margin="0,0,0,4"/>
                                    <Label Content="Vergalhão:" Padding="0,2,0,0"/>
                                    <ComboBox x:Name="cmbInfYBarra" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <Label Content="Cobrimento (cm):" Padding="0,2,0,0"/>
                                            <TextBox x:Name="txtInfYCob" Text="5"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <Label Content="Offset Z (cm):" Padding="0,2,0,0"/>
                                            <TextBox x:Name="txtInfYOffZ" Text="0"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <RadioButton x:Name="rbInfYQtd" Content="Por quantidade" IsChecked="True" Margin="0,0,8,0"/>
                                        <RadioButton x:Name="rbInfYEsp" Content="Por espaçamento"/>
                                    </StackPanel>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <Label Content="Quantidade:" Padding="0,2,0,0"/>
                                            <TextBox x:Name="txtInfYQtd" Text="4"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <Label Content="Espaçamento (cm):" Padding="0,2,0,0"/>
                                            <TextBox x:Name="txtInfYEsp" Text="15" IsEnabled="False"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <GroupBox Grid.Column="1" Header="Dobra">
                                    <StackPanel Margin="4">
                                        <CheckBox x:Name="chkInfYDobI" Content="Dobra inicial" Margin="0,0,0,2"/>
                                        <Label Content="Comprimento (cm):" Padding="0,0,0,0"/>
                                        <TextBox x:Name="txtInfYDobIComp" Text="10" Margin="0,0,0,2"/>
                                        <RadioButton x:Name="rbInfYDobICima" Content="Para cima" IsChecked="True" GroupName="InfYDobIDir"/>
                                        <RadioButton x:Name="rbInfYDobIBaixo" Content="Para baixo" GroupName="InfYDobIDir" Margin="0,0,0,6"/>
                                        <Separator/>
                                        <CheckBox x:Name="chkInfYDobF" Content="Dobra final" Margin="0,4,0,2"/>
                                        <Label Content="Comprimento (cm):" Padding="0,0,0,0"/>
                                        <TextBox x:Name="txtInfYDobFComp" Text="10" Margin="0,0,0,2"/>
                                        <RadioButton x:Name="rbInfYDobFCima" Content="Para cima" IsChecked="True" GroupName="InfYDobFDir"/>
                                        <RadioButton x:Name="rbInfYDobFBaixo" Content="Para baixo" GroupName="InfYDobFDir"/>
                                    </StackPanel>
                                </GroupBox>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================
                 TAB SUPERIOR
                 ============================================================ -->
            <TabItem Header="Superior">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <CheckBox x:Name="chkLancarSuperior" Content="Lançar armadura superior"
                                  FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <GroupBox Header="Barras em X  (distribuídas ao longo de Y)" Margin="0,0,0,6">
                            <Grid Margin="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <CheckBox x:Name="chkSupXAtivo" Content="Ativo" IsChecked="True" Margin="0,0,0,4"/>
                                    <Label Content="Vergalhão:" Padding="0,2,0,0"/>
                                    <ComboBox x:Name="cmbSupXBarra" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <Label Content="Cobrimento (cm):" Padding="0,2,0,0"/>
                                            <TextBox x:Name="txtSupXCob" Text="5"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <Label Content="Offset Z (cm):" Padding="0,2,0,0"/>
                                            <TextBox x:Name="txtSupXOffZ" Text="0"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <RadioButton x:Name="rbSupXQtd" Content="Por quantidade" IsChecked="True" Margin="0,0,8,0"/>
                                        <RadioButton x:Name="rbSupXEsp" Content="Por espaçamento"/>
                                    </StackPanel>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <Label Content="Quantidade:" Padding="0,2,0,0"/>
                                            <TextBox x:Name="txtSupXQtd" Text="4"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <Label Content="Espaçamento (cm):" Padding="0,2,0,0"/>
                                            <TextBox x:Name="txtSupXEsp" Text="15" IsEnabled="False"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <GroupBox Grid.Column="1" Header="Dobra">
                                    <StackPanel Margin="4">
                                        <CheckBox x:Name="chkSupXDobI" Content="Dobra inicial" Margin="0,0,0,2"/>
                                        <Label Content="Comprimento (cm):" Padding="0,0,0,0"/>
                                        <TextBox x:Name="txtSupXDobIComp" Text="10" Margin="0,0,0,2"/>
                                        <RadioButton x:Name="rbSupXDobICima" Content="Para cima" IsChecked="True" GroupName="SupXDobIDir"/>
                                        <RadioButton x:Name="rbSupXDobIBaixo" Content="Para baixo" GroupName="SupXDobIDir" Margin="0,0,0,6"/>
                                        <Separator/>
                                        <CheckBox x:Name="chkSupXDobF" Content="Dobra final" Margin="0,4,0,2"/>
                                        <Label Content="Comprimento (cm):" Padding="0,0,0,0"/>
                                        <TextBox x:Name="txtSupXDobFComp" Text="10" Margin="0,0,0,2"/>
                                        <RadioButton x:Name="rbSupXDobFCima" Content="Para cima" IsChecked="True" GroupName="SupXDobFDir"/>
                                        <RadioButton x:Name="rbSupXDobFBaixo" Content="Para baixo" GroupName="SupXDobFDir"/>
                                    </StackPanel>
                                </GroupBox>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Barras em Y  (distribuídas ao longo de X)">
                            <Grid Margin="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <CheckBox x:Name="chkSupYAtivo" Content="Ativo" IsChecked="True" Margin="0,0,0,4"/>
                                    <Label Content="Vergalhão:" Padding="0,2,0,0"/>
                                    <ComboBox x:Name="cmbSupYBarra" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <Label Content="Cobrimento (cm):" Padding="0,2,0,0"/>
                                            <TextBox x:Name="txtSupYCob" Text="5"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <Label Content="Offset Z (cm):" Padding="0,2,0,0"/>
                                            <TextBox x:Name="txtSupYOffZ" Text="0"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <RadioButton x:Name="rbSupYQtd" Content="Por quantidade" IsChecked="True" Margin="0,0,8,0"/>
                                        <RadioButton x:Name="rbSupYEsp" Content="Por espaçamento"/>
                                    </StackPanel>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <Label Content="Quantidade:" Padding="0,2,0,0"/>
                                            <TextBox x:Name="txtSupYQtd" Text="4"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <Label Content="Espaçamento (cm):" Padding="0,2,0,0"/>
                                            <TextBox x:Name="txtSupYEsp" Text="15" IsEnabled="False"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <GroupBox Grid.Column="1" Header="Dobra">
                                    <StackPanel Margin="4">
                                        <CheckBox x:Name="chkSupYDobI" Content="Dobra inicial" Margin="0,0,0,2"/>
                                        <Label Content="Comprimento (cm):" Padding="0,0,0,0"/>
                                        <TextBox x:Name="txtSupYDobIComp" Text="10" Margin="0,0,0,2"/>
                                        <RadioButton x:Name="rbSupYDobICima" Content="Para cima" IsChecked="True" GroupName="SupYDobIDir"/>
                                        <RadioButton x:Name="rbSupYDobIBaixo" Content="Para baixo" GroupName="SupYDobIDir" Margin="0,0,0,6"/>
                                        <Separator/>
                                        <CheckBox x:Name="chkSupYDobF" Content="Dobra final" Margin="0,4,0,2"/>
                                        <Label Content="Comprimento (cm):" Padding="0,0,0,0"/>
                                        <TextBox x:Name="txtSupYDobFComp" Text="10" Margin="0,0,0,2"/>
                                        <RadioButton x:Name="rbSupYDobFCima" Content="Para cima" IsChecked="True" GroupName="SupYDobFDir"/>
                                        <RadioButton x:Name="rbSupYDobFBaixo" Content="Para baixo" GroupName="SupYDobFDir"/>
                                    </StackPanel>
                                </GroupBox>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================
                 TAB LATERAL / PELE
                 ============================================================ -->
            <TabItem Header="Lateral / Pele">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <CheckBox x:Name="chkLancarLateral" Content="Lançar armadura lateral / pele"
                                  FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <GroupBox Header="Configuração geral" Margin="0,0,0,6">
                            <Grid Margin="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <Label Content="Vergalhão:" Padding="0,2,0,0"/>
                                    <ComboBox x:Name="cmbLatBarra" Margin="0,0,0,4"/>
                                    <Label Content="Cobrimento (cm):" Padding="0,2,0,0"/>
                                    <TextBox x:Name="txtLatCob" Text="5" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <RadioButton x:Name="rbLatQtd" Content="Por quantidade" IsChecked="True" Margin="0,0,8,0"/>
                                        <RadioButton x:Name="rbLatEsp" Content="Por espaçamento"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <Label Content="Níveis verticais:" Padding="0,2,0,0"/>
                                            <TextBox x:Name="txtLatQtd" Text="2"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <Label Content="Espaçamento (cm):" Padding="0,2,0,0"/>
                                            <TextBox x:Name="txtLatEsp" Text="20" IsEnabled="False"/>
                                        </StackPanel>
                                    </Grid>
                                    <Label Content="Faces a lançar:" Padding="0,8,0,2"/>
                                    <CheckBox x:Name="chkLatFacesX" Content="Faces em X (barras paralelas a Y)" IsChecked="True" Margin="0,0,0,2"/>
                                    <CheckBox x:Name="chkLatFacesY" Content="Faces em Y (barras paralelas a X)" IsChecked="True"/>
                                </StackPanel>
                                <GroupBox Grid.Column="1" Header="Dobra">
                                    <StackPanel Margin="4">
                                        <CheckBox x:Name="chkLatDobI" Content="Dobra inicial" Margin="0,0,0,2"/>
                                        <Label Content="Comprimento (cm):" Padding="0,0,0,0"/>
                                        <TextBox x:Name="txtLatDobIComp" Text="10" Margin="0,0,0,2"/>
                                        <RadioButton x:Name="rbLatDobICima" Content="Para cima" IsChecked="True" GroupName="LatDobIDir"/>
                                        <RadioButton x:Name="rbLatDobIBaixo" Content="Para baixo" GroupName="LatDobIDir" Margin="0,0,0,6"/>
                                        <Separator/>
                                        <CheckBox x:Name="chkLatDobF" Content="Dobra final" Margin="0,4,0,2"/>
                                        <Label Content="Comprimento (cm):" Padding="0,0,0,0"/>
                                        <TextBox x:Name="txtLatDobFComp" Text="10" Margin="0,0,0,2"/>
                                        <RadioButton x:Name="rbLatDobFCima" Content="Para cima" IsChecked="True" GroupName="LatDobFDir"/>
                                        <RadioButton x:Name="rbLatDobFBaixo" Content="Para baixo" GroupName="LatDobFDir"/>
                                    </StackPanel>
                                </GroupBox>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================
                 TAB ESTRIBOS VERTICAIS
                 ============================================================ -->
            <TabItem Header="Est. Vertical">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <CheckBox x:Name="chkLancarEstVert" Content="Lançar estribos verticais (quadros fechados)"
                                  FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <Label Content="Vergalhão:" Padding="0,2,0,0"/>
                                <ComboBox x:Name="cmbEstVertBarra" Margin="0,0,0,4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <Label Content="Cobrimento (cm):" Padding="0,2,0,0"/>
                                <TextBox x:Name="txtEstVertCob" Text="5"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Ângulo da garra:" Padding="0,4,0,0"/>
                            <ComboBox x:Name="cmbEstVertGarra" Grid.Column="1" Width="120">
                                <ComboBoxItem Content="90°"/>
                                <ComboBoxItem Content="135°" IsSelected="True"/>
                                <ComboBoxItem Content="180°"/>
                            </ComboBox>
                        </Grid>

                        <GroupBox Header="Direção X  (quadros no plano YZ, distribuídos ao longo de X)" Margin="0,0,0,6">
                            <StackPanel Margin="6">
                                <CheckBox x:Name="chkEstVertXAtivo" Content="Ativo" IsChecked="True" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <RadioButton x:Name="rbEstVertXQtd" Content="Por quantidade" IsChecked="True" Margin="0,0,8,0"/>
                                    <RadioButton x:Name="rbEstVertXEsp" Content="Por espaçamento"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <Label Content="Quantidade:" Padding="0,2,0,0"/>
                                        <TextBox x:Name="txtEstVertXQtd" Text="2"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Label Content="Espaçamento (cm):" Padding="0,2,0,0"/>
                                        <TextBox x:Name="txtEstVertXEsp" Text="20" IsEnabled="False"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Direção Y  (quadros no plano XZ, distribuídos ao longo de Y)">
                            <StackPanel Margin="6">
                                <CheckBox x:Name="chkEstVertYAtivo" Content="Ativo" IsChecked="True" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <RadioButton x:Name="rbEstVertYQtd" Content="Por quantidade" IsChecked="True" Margin="0,0,8,0"/>
                                    <RadioButton x:Name="rbEstVertYEsp" Content="Por espaçamento"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <Label Content="Quantidade:" Padding="0,2,0,0"/>
                                        <TextBox x:Name="txtEstVertYQtd" Text="2"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Label Content="Espaçamento (cm):" Padding="0,2,0,0"/>
                                        <TextBox x:Name="txtEstVertYEsp" Text="20" IsEnabled="False"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================
                 TAB ESTRIBOS HORIZONTAIS
                 ============================================================ -->
            <TabItem Header="Est. Horizontal">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <CheckBox x:Name="chkLancarEstHoriz" Content="Lançar estribos horizontais (quadros em plano XY)"
                                  FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <Label Content="Vergalhão:" Padding="0,2,0,0"/>
                                <ComboBox x:Name="cmbEstHorizBarra" Margin="0,0,0,4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <Label Content="Cobrimento (cm):" Padding="0,2,0,0"/>
                                <TextBox x:Name="txtEstHorizCob" Text="5"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Ângulo da garra:" Padding="0,4,0,0"/>
                            <ComboBox x:Name="cmbEstHorizGarra" Grid.Column="1" Width="120">
                                <ComboBoxItem Content="90°"/>
                                <ComboBoxItem Content="135°" IsSelected="True"/>
                                <ComboBoxItem Content="180°"/>
                            </ComboBox>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <RadioButton x:Name="rbEstHorizQtd" Content="Por quantidade" IsChecked="True" Margin="0,0,8,0"/>
                            <RadioButton x:Name="rbEstHorizEsp" Content="Por espaçamento"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <Label Content="Quantidade:" Padding="0,2,0,0"/>
                                <TextBox x:Name="txtEstHorizQtd" Text="2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Label Content="Espaçamento (cm):" Padding="0,2,0,0"/>
                                <TextBox x:Name="txtEstHorizEsp" Text="20" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================
                 TAB FAIXA TRANSVERSAL
                 ============================================================ -->
            <TabItem Header="Faixa Trans.">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <CheckBox x:Name="chkLancarFaixaTrans" Content="Lançar faixa transversal adicional"
                                  FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <Label Content="Vergalhão:" Padding="0,2,0,0"/>
                                <ComboBox x:Name="cmbFaixaTransBarra" Margin="0,0,0,4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <Label Content="Cobrimento (cm):" Padding="0,2,0,0"/>
                                <TextBox x:Name="txtFaixaTransCob" Text="5"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <Label Content="Espaçamento (cm):" Padding="0,2,0,0"/>
                                <TextBox x:Name="txtFaixaTransEsp" Text="15"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <Label Content="Posição Z desde base (cm):" Padding="0,2,0,0"/>
                                <TextBox x:Name="txtFaixaTransPosZ" Text="10"/>
                            </StackPanel>
                        </Grid>
                        <Label Content="Direção:" Padding="0,4,0,2"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton x:Name="rbFaixaTransX" Content="Apenas X" Margin="0,0,8,0"/>
                            <RadioButton x:Name="rbFaixaTransY" Content="Apenas Y" Margin="0,0,8,0"/>
                            <RadioButton x:Name="rbFaixaTransAmbos" Content="Ambos X e Y" IsChecked="True"/>
                        </StackPanel>

                        <GroupBox Header="Dobra">
                            <Grid Margin="6">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <CheckBox x:Name="chkFaixaTransDobI" Content="Dobra inicial" Margin="0,0,0,2"/>
                                    <Label Content="Comprimento (cm):" Padding="0,0,0,0"/>
                                    <TextBox x:Name="txtFaixaTransDobIComp" Text="10" Margin="0,0,0,2"/>
                                    <RadioButton x:Name="rbFaixaTransDobICima" Content="Para cima" IsChecked="True" GroupName="FaixaTransDobIDir"/>
                                    <RadioButton x:Name="rbFaixaTransDobIBaixo" Content="Para baixo" GroupName="FaixaTransDobIDir"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <CheckBox x:Name="chkFaixaTransDobF" Content="Dobra final" Margin="0,0,0,2"/>
                                    <Label Content="Comprimento (cm):" Padding="0,0,0,0"/>
                                    <TextBox x:Name="txtFaixaTransDobFComp" Text="10" Margin="0,0,0,2"/>
                                    <RadioButton x:Name="rbFaixaTransDobFCima" Content="Para cima" IsChecked="True" GroupName="FaixaTransDobFDir"/>
                                    <RadioButton x:Name="rbFaixaTransDobFBaixo" Content="Para baixo" GroupName="FaixaTransDobFDir"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Botoes -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="btnOk" Content="Lançar" Width="90" Height="28" Margin="0,0,8,0"/>
            <Button x:Name="btnCancel" Content="Cancelar" Width="90" Height="28"/>
        </StackPanel>
    </Grid>
</Window>
