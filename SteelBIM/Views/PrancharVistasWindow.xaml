<Window x:Class="SteelBIM.Views.PrancharVistasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pranchar Vistas"
        SizeToContent="Height" Width="460"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SteelBIM;component/Views/Themes/AppTheme.Base.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="14">
        <TextBlock x:Name="txtResumoSelecao" Text="" Margin="0 0 0 10" TextWrapping="Wrap" FontWeight="SemiBold"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Carimbo (formato):" VerticalAlignment="Center"/>
            <ComboBox x:Name="cmbTitleBlock" Grid.Row="0" Grid.Column="1" Margin="4 3"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Ordenar vistas por:" VerticalAlignment="Center"/>
            <ComboBox x:Name="cmbOrdenar" Grid.Row="1" Grid.Column="1" Margin="4 3"/>

            <Label Grid.Row="2" Grid.Column="0" Content="Colunas (vazio = automático):" VerticalAlignment="Center"/>
            <TextBox x:Name="txtColunas" Grid.Row="2" Grid.Column="1" Margin="4 3" Text=""/>

            <Label Grid.Row="3" Grid.Column="0" Content="Margem (mm):" VerticalAlignment="Center"/>
            <TextBox x:Name="txtMargem" Grid.Row="3" Grid.Column="1" Margin="4 3" Text="20"/>

            <Label Grid.Row="4" Grid.Column="0" Content="Espaçamento (mm):" VerticalAlignment="Center"/>
            <TextBox x:Name="txtEspacamento" Grid.Row="4" Grid.Column="1" Margin="4 3" Text="10"/>

            <Label Grid.Row="5" Grid.Column="0" Content="Reserva do carimbo à direita (mm):" VerticalAlignment="Center"/>
            <TextBox x:Name="txtReservaCarimbo" Grid.Row="5" Grid.Column="1" Margin="4 3" Text="0"/>

            <Label Grid.Row="6" Grid.Column="0" Content="Nº / Nome da prancha:" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="4 3">
                <TextBox x:Name="txtNumero" Width="90" Text=""/>
                <TextBox x:Name="txtNome" Width="150" Margin="6 0 0 0" Text="PRANCHA"/>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 14 0 0">
            <Button x:Name="btnCancel" Content="Cancelar" Width="90" Margin="0 0 8 0" Style="{StaticResource SecondaryActionButton}"/>
            <Button x:Name="btnOk" Content="Criar Prancha" Width="120" Style="{StaticResource PrimaryActionButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
